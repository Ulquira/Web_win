FROM node:20-alpine
WORKDIR /app

# Copiamos manifiestos de dependencias
COPY package*.json ./

# Instalamos dependencias de produccion y tsx para ejecucion directa
RUN npm ci --omit=dev && npm install tsx --no-save

# Copiamos modulos de backend
COPY ./server ./server
COPY ./capa_intermedia ./capa_intermedia

EXPOSE 3001

CMD ["npx", "tsx", "server/index.ts"]